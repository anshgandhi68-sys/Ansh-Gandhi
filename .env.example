# ==========================================
# Ansh A Gandhi Digital Platform — Environment Variables
# ==========================================

# Canonical Deployment Origin
NEXT_PUBLIC_SITE_URL=https://ansh-gandhi.vercel.app

# ------------------------------------------
# Email Dispatch Infrastructure (Resend)
# ------------------------------------------
# API Key from resend.com (starts with re_...)
RESEND_API_KEY=

# Verified Sender on domain owned by Ansh (e.g., workivo.in)
CONTACT_FROM_EMAIL="Ansh Gandhi Platform <connect@workivo.in>"

# Recipient Email for Platform Inquiries
CONTACT_RECIPIENT_EMAIL=connect@workivo.in

# ------------------------------------------
# Distributed Rate Limiting (Upstash Redis)
# ------------------------------------------
# REST URL and Token from console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------
# Durable Storage Infrastructure (Supabase)
# ------------------------------------------
# Project URL & Service Role Key (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
