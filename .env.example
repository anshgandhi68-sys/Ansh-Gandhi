# ==========================================
# Ansh A Gandhi Digital Platform — Environment Variables
# ==========================================

# Canonical Deployment Origin
NEXT_PUBLIC_SITE_URL=https://ansh-gandhi.vercel.app

# Optional: External Email Dispatch Service (Resend)
# If provided, submissions from /api/contact are dispatched to the recipient email.
# If omitted, submissions are validated, recorded, and assigned an audit reference ID.
RESEND_API_KEY=

# Recipient Email for Platform Inquiries
CONTACT_RECIPIENT_EMAIL=connect@workivo.in
